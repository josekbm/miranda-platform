# Entorno local (copiar a .env)
NODE_ENV=development

# Base de datos local (Docker Compose de infra)
DATABASE_URL=postgresql://miranda:miranda@localhost:5432/miranda

# API
API_PORT=3000
API_URL=http://localhost:3000
WEB_URL=http://localhost:4321
ADMIN_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173

# Auth (cambiar en producción)
JWT_SECRET=dev-only-change-me
COOKIE_SECRET=dev-only-change-me

# Email (Mailpit en local)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
MAIL_FROM=reservas@miranda.local

# Uploads
UPLOAD_DIR=./.data/uploads
PUBLIC_MEDIA_URL=http://localhost:3000/media

# Web
PUBLIC_SITE_URL=http://localhost:4321
PUBLIC_API_INTERNAL_URL=http://localhost:3000
PUBLIC_TURNSTILE_SITE_KEY=

# Dashboard
VITE_API_URL=http://localhost:3000
VITE_PUBLIC_SITE_URL=http://localhost:4321
VITE_DEMO_MODE=true

# Analítica (opcional en local)
UMAMI_DATABASE_URL=postgresql://umami:umami@localhost:5432/umami
