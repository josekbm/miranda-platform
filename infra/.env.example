# Entorno de producción (copiar a .env en el servidor)
NODE_ENV=production

# Red externa de Nginx Proxy Manager
NPM_NETWORK=npm_proxy

# Postgres (usado por docker-compose.prod.yml)
POSTGRES_DB=miranda
POSTGRES_USER=miranda
POSTGRES_PASSWORD=CAMBIAR

# Base de datos para ejecutar Prisma desde el host
DATABASE_URL=postgresql://miranda:CAMBIAR@db:5432/miranda

# API
API_PORT=3000
API_URL=https://api.miranda.tudominio.com
WEB_URL=https://miranda.tudominio.com
ADMIN_URL=https://admin.miranda.tudominio.com
CORS_ORIGINS=https://admin.miranda.tudominio.com

# Auth
JWT_SECRET=CAMBIAR
COOKIE_SECRET=CAMBIAR

# Email (Resend/Brevo u otro relay)
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASS=CAMBIAR
MAIL_FROM=reservas@tudominio.com

# Uploads
UPLOAD_DIR=/data/uploads
PUBLIC_MEDIA_URL=https://api.miranda.tudominio.com/media

# Web
PUBLIC_SITE_URL=https://miranda.tudominio.com
PUBLIC_API_INTERNAL_URL=http://api:3000
PUBLIC_TURNSTILE_SITE_KEY=CAMBIAR
TURNSTILE_SECRET_KEY=CAMBIAR

# Dashboard
VITE_API_URL=https://api.miranda.tudominio.com
VITE_PUBLIC_SITE_URL=https://miranda.tudominio.com
VITE_DEMO_MODE=true

# Analítica
UMAMI_DATABASE_URL=postgresql://umami:CAMBIAR@db:5432/umami
