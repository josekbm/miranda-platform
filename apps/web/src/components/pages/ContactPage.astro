---
import { getRoomBySlug, roomName } from "../../data/rooms";
import { hotel, imageUrl } from "../../data/site";
import type { Locale } from "../../i18n/ui";
import { getTranslations } from "../../i18n/ui";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Icon from "../Icon.astro";
import PageHero from "../PageHero.astro";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getTranslations(locale);
const params = Astro.url.searchParams;
const roomSlug = params.get("room");
const room = roomSlug ? getRoomBySlug(roomSlug) : undefined;
const checkIn = params.get("checkIn");
const checkOut = params.get("checkOut");
const guests = params.get("guests");
const heroImage = "https://images.unsplash.com/photo-1566073771259-6a8506099945";
const site = Astro.site ?? new URL(Astro.url.origin);
const pageUrl = new URL(Astro.url.pathname, site).toString();
const mapsUrl = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(
  `${hotel.address}, ${hotel.city}`,
)}`;

const subject = room ? `${locale === "es" ? "Reserva" : "Booking"}: ${roomName(room, locale)}` : "";

const message = room
  ? `${[
      locale === "es"
        ? `Hola, me gustaría reservar ${roomName(room, locale)}`
        : `Hello, I would like to book ${roomName(room, locale)}`,
      checkIn ? `${locale === "es" ? "del" : "from"} ${checkIn}` : "",
      checkOut ? `${locale === "es" ? "al" : "to"} ${checkOut}` : "",
      guests
        ? `${locale === "es" ? "para" : "for"} ${guests} ${locale === "es" ? "huéspedes" : "guests"}`
        : "",
    ]
      .filter(Boolean)
      .join(" ")}.`
  : "";

const contactCards = [
  {
    icon: "phone",
    title: t.contact.phoneTitle,
    value: hotel.phone,
    href: `tel:${hotel.phone.replace(/\s/g, "")}`,
  },
  {
    icon: "mail",
    title: t.contact.emailTitle,
    value: hotel.email,
    href: `mailto:${hotel.email}`,
  },
  {
    icon: "map-pin",
    title: t.contact.addressTitle,
    value: `${hotel.address}, ${hotel.city}`,
    href: mapsUrl,
  },
  {
    icon: "calendar",
    title: t.contact.reception,
    value: t.contact.receptionHours,
    href: undefined,
  },
];

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "ContactPage",
  name: locale === "es" ? "Contacto · Hotel Miranda" : "Contact · Hotel Miranda",
  url: pageUrl,
  mainEntity: {
    "@type": "Hotel",
    name: hotel.name,
    telephone: hotel.phone,
    email: hotel.email,
    address: {
      "@type": "PostalAddress",
      streetAddress: hotel.address,
      addressLocality: hotel.city,
      postalCode: hotel.postalCode,
      addressCountry: "ES",
    },
  },
};
---

<BaseLayout
  locale={locale}
  title={locale === "es" ? "Contacto · Hotel Miranda" : "Contact · Hotel Miranda"}
  description={t.contact.lead}
  image={imageUrl(heroImage, 1600)}
  alternatePath={locale === "es" ? "/en/contact" : "/contacto"}
  jsonLd={jsonLd}
>
  <PageHero
    locale={locale}
    pretitle={t.contact.pretitle}
    title={t.contact.title}
    lead={t.contact.lead}
    image={heroImage}
    breadcrumb={t.nav.contact}
  />

  <section class="container-miranda py-16 lg:py-20">
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {contactCards.map((card) => {
        const content = (
          <>
            <span class="grid h-11 w-11 place-items-center rounded-full bg-sand-100 text-sea-700">
              <Icon name={card.icon} class="h-5 w-5" />
            </span>
            <h3 class="mt-5 text-[10px] font-semibold uppercase tracking-[0.18em] text-ink-500">
              {card.title}
            </h3>
            <p class="mt-2 text-sm font-medium leading-6 text-ink-900">{card.value}</p>
          </>
        );

        return card.href ? (
          <a
            href={card.href}
            class="rounded-[1.5rem] border border-ink-900/10 bg-white p-6 transition hover:-translate-y-1 hover:border-brass-400 hover:shadow-lg"
          >
            {content}
          </a>
        ) : (
          <div class="rounded-[1.5rem] border border-ink-900/10 bg-white p-6">{content}</div>
        );
      })}
    </div>
  </section>

  <section class="container-miranda pb-20 lg:pb-28">
    <div class="grid gap-10 lg:grid-cols-[1fr_0.9fr]">
      <div
        id="contact-form"
        class="scroll-mt-28 rounded-[1.75rem] border border-ink-900/10 bg-white p-7 sm:p-9"
      >
        <h2 class="display-3">{t.contact.formTitle}</h2>
        <p class="body mt-3">{t.contact.formNote}</p>

        <form
          action={`mailto:${hotel.email}`}
          method="post"
          enctype="text/plain"
          class="mt-8 grid gap-4 sm:grid-cols-2"
        >
          <div>
            <label
              for="contact-name"
              class="text-[10px] font-semibold uppercase tracking-[0.18em] text-ink-500"
            >
              {t.common.name}
            </label>
            <input
              id="contact-name"
              name="name"
              type="text"
              required
              class="mt-2 w-full rounded-xl border border-ink-900/15 bg-sand-50 px-4 py-3 text-sm text-ink-900 focus:border-sea-700 focus:outline-none"
            >
          </div>
          <div>
            <label
              for="contact-email"
              class="text-[10px] font-semibold uppercase tracking-[0.18em] text-ink-500"
            >
              {t.common.email}
            </label>
            <input
              id="contact-email"
              name="email"
              type="email"
              required
              class="mt-2 w-full rounded-xl border border-ink-900/15 bg-sand-50 px-4 py-3 text-sm text-ink-900 focus:border-sea-700 focus:outline-none"
            >
          </div>
          <div>
            <label
              for="contact-phone"
              class="text-[10px] font-semibold uppercase tracking-[0.18em] text-ink-500"
            >
              {t.common.phone}
            </label>
            <input
              id="contact-phone"
              name="phone"
              type="tel"
              class="mt-2 w-full rounded-xl border border-ink-900/15 bg-sand-50 px-4 py-3 text-sm text-ink-900 focus:border-sea-700 focus:outline-none"
            >
          </div>
          <div>
            <label
              for="contact-subject"
              class="text-[10px] font-semibold uppercase tracking-[0.18em] text-ink-500"
            >
              {t.common.subject}
            </label>
            <input
              id="contact-subject"
              name="subject"
              type="text"
              value={subject}
              class="mt-2 w-full rounded-xl border border-ink-900/15 bg-sand-50 px-4 py-3 text-sm text-ink-900 focus:border-sea-700 focus:outline-none"
            >
          </div>
          <div class="sm:col-span-2">
            <label
              for="contact-message"
              class="text-[10px] font-semibold uppercase tracking-[0.18em] text-ink-500"
            >
              {t.common.message}
            </label>
            <textarea
              id="contact-message"
              name="message"
              rows="6"
              required
              class="mt-2 w-full rounded-xl border border-ink-900/15 bg-sand-50 px-4 py-3 text-sm text-ink-900 focus:border-sea-700 focus:outline-none"
            >{message}</textarea>
          </div>
          <div class="sm:col-span-2">
            <button type="submit" class="btn-primary w-full sm:w-auto">
              {t.common.send}
              <Icon name="arrow-right" class="h-4 w-4" />
            </button>
          </div>
        </form>
      </div>

      <div class="flex flex-col gap-4">
        <div
          class="relative flex min-h-[320px] flex-1 flex-col justify-between overflow-hidden rounded-[1.75rem] bg-sea-700 p-8 text-white"
        >
          <div
            class="absolute -right-16 -top-16 h-64 w-64 rounded-full border border-white/10"
          ></div>
          <div
            class="absolute -bottom-24 -left-16 h-72 w-72 rounded-full border border-white/10"
          ></div>
          <div class="relative">
            <p class="pretitle text-brass-400">{t.contact.addressTitle}</p>
            <p class="mt-4 font-display text-3xl leading-tight">{hotel.address}</p>
            <p class="mt-1 text-white/60">{hotel.postalCode} {hotel.city}, {hotel.country}</p>
          </div>
          <div class="relative mt-8">
            <a
              href={mapsUrl}
              target="_blank"
              rel="noreferrer"
              class="inline-flex items-center gap-2 rounded-full bg-white/10 px-5 py-3 text-sm font-semibold text-white backdrop-blur transition hover:bg-white hover:text-ink-900"
            >
              <Icon name="map-pin" class="h-4 w-4" />
              {locale === "es" ? "Abrir en Google Maps" : "Open in Google Maps"}
            </a>
          </div>
        </div>

        <div class="rounded-[1.5rem] border border-ink-900/10 bg-sand-100 p-6">
          <p class="text-[10px] font-semibold uppercase tracking-[0.18em] text-ink-500">
            {t.contact.reception}
          </p>
          <p class="mt-2 font-display text-2xl text-ink-900">{t.contact.receptionHours}</p>
          <p class="mt-2 text-sm leading-6 text-ink-500">
            {locale === "es"
              ? "Si llegas fuera de horario, avísanos y lo organizamos."
              : "If you arrive outside these hours, let us know and we will arrange it."}
          </p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
