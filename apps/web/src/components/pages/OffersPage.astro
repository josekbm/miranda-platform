---
import { imageUrl, offers } from "../../data/site";
import type { Locale } from "../../i18n/ui";
import { getTranslations, routeFor } from "../../i18n/ui";
import BaseLayout from "../../layouts/BaseLayout.astro";
import ButtonLink from "../ButtonLink.astro";
import Icon from "../Icon.astro";
import OfferCard from "../OfferCard.astro";
import PageHero from "../PageHero.astro";
import SectionHeading from "../SectionHeading.astro";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getTranslations(locale);
const heroImage = "https://images.unsplash.com/photo-1540541338287-41700207dee6";
const site = Astro.site ?? new URL(Astro.url.origin);
const pageUrl = new URL(Astro.url.pathname, site).toString();

const steps = [
  {
    icon: "calendar",
    title: locale === "es" ? "Elige tus fechas" : "Choose your dates",
    text:
      locale === "es"
        ? "Dinos cuándo quieres venir y cuántos sois. Te ayudamos a encontrar la mejor habitación."
        : "Tell us when you want to come and how many you are. We will help you find the best room.",
  },
  {
    icon: "mail",
    title: locale === "es" ? "Escríbenos" : "Write to us",
    text:
      locale === "es"
        ? "Cuéntanos la ocasión y cualquier detalle especial. Respondemos en menos de 24 horas."
        : "Tell us the occasion and any special details. We reply within 24 hours.",
  },
  {
    icon: "check",
    title: locale === "es" ? "Confirmamos" : "We confirm",
    text:
      locale === "es"
        ? "Te enviamos disponibilidad, precio final y todo lo que necesitas para llegar."
        : "We send you availability, the final price and everything you need to arrive.",
  },
];

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "OfferCatalog",
  name: locale === "es" ? "Ofertas de Hotel Miranda" : "Hotel Miranda offers",
  url: pageUrl,
  itemListElement: offers.map((offer, index) => ({
    "@type": "Offer",
    position: index + 1,
    name: locale === "es" ? offer.titleEs : offer.titleEn,
    description: locale === "es" ? offer.textEs : offer.textEn,
    priceCurrency: "EUR",
    availability: "https://schema.org/InStock",
    validThrough: offer.validUntil,
  })),
};
---

<BaseLayout
  locale={locale}
  title={locale === "es" ? "Ofertas · Hotel Miranda" : "Offers · Hotel Miranda"}
  description={t.offers.lead}
  image={imageUrl(heroImage, 1600)}
  alternatePath={locale === "es" ? "/en/offers" : "/ofertas"}
  jsonLd={jsonLd}
>
  <PageHero
    locale={locale}
    pretitle={t.offers.pretitle}
    title={t.offers.title}
    lead={t.offers.lead}
    image={heroImage}
    breadcrumb={t.nav.offers}
  />

  <section class="container-miranda py-20 lg:py-28">
    <div class="grid gap-6 md:grid-cols-2">
      {offers.map((offer) => <OfferCard offer={offer} locale={locale} />)}
    </div>
  </section>

  <section class="bg-sand-100 py-20 lg:py-24">
    <div class="container-miranda">
      <SectionHeading title={locale === "es" ? "Así funciona" : "How it works"} align="center" />
      <div class="mt-12 grid gap-5 md:grid-cols-3">
        {steps.map((step, index) => (
          <article class="rounded-[1.5rem] border border-ink-900/10 bg-white p-7">
            <div class="flex items-center justify-between">
              <span class="grid h-12 w-12 place-items-center rounded-full bg-sand-100 text-sea-700">
                <Icon name={step.icon} class="h-5 w-5" />
              </span>
              <span class="font-display text-3xl text-brass-400">0{index + 1}</span>
            </div>
            <h3 class="mt-6 font-display text-2xl text-ink-900">{step.title}</h3>
            <p class="mt-3 text-sm leading-6 text-ink-500">{step.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="bg-ink-900 py-20">
    <div
      class="container-miranda flex flex-col items-start justify-between gap-8 md:flex-row md:items-center"
    >
      <div>
        <p class="pretitle text-brass-400">{t.nav.contact}</p>
        <h2 class="display-2 mt-3 max-w-2xl text-white">{t.offers.ctaTitle}</h2>
        <p class="mt-4 max-w-xl text-white/55">{t.offers.ctaLead}</p>
      </div>
      <ButtonLink href={routeFor(locale, "contact")} variant="gold" class="shrink-0">
        {t.offers.ctaButton}
        <Icon name="arrow-right" class="h-4 w-4" />
      </ButtonLink>
    </div>
  </section>
</BaseLayout>
