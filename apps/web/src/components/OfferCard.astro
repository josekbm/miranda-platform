---
import { imageUrl, type Offer } from "../data/site";
import type { Locale } from "../i18n/ui";
import { getTranslations, routeFor } from "../i18n/ui";
import Icon from "./Icon.astro";

interface Props {
  offer: Offer;
  locale: Locale;
}

const { offer, locale } = Astro.props;
const t = getTranslations(locale);
const title = locale === "es" ? offer.titleEs : offer.titleEn;
const text = locale === "es" ? offer.textEs : offer.textEn;
const validUntil = new Intl.DateTimeFormat(locale === "es" ? "es-ES" : "en-GB", {
  day: "numeric",
  month: "short",
  year: "numeric",
}).format(new Date(offer.validUntil));
---

<article class="group overflow-hidden rounded-[1.75rem] border border-ink-900/10 bg-white">
  <div class="relative aspect-[16/10] overflow-hidden bg-sand-200">
    <img
      src={imageUrl(offer.image, 1000)}
      alt={title}
      width="1000"
      height="625"
      loading="lazy"
      decoding="async"
      class="h-full w-full object-cover transition duration-700 group-hover:scale-105"
    >
    <span
      class="absolute left-4 top-4 rounded-full bg-terracotta-500 px-3 py-1.5 text-[10px] font-semibold uppercase tracking-[0.16em] text-white"
    >
      -{offer.discountPct}%
    </span>
  </div>

  <div class="p-6">
    <p class="text-[10px] font-semibold uppercase tracking-[0.2em] text-ink-500">
      {t.offers.validUntil} {validUntil}
    </p>
    <h3 class="mt-2 font-display text-2xl text-ink-900">{title}</h3>
    <p class="mt-3 text-sm leading-6 text-ink-500">{text}</p>
    <a
      href={routeFor(locale, "rooms")}
      class="mt-5 inline-flex items-center gap-1.5 text-xs font-semibold uppercase tracking-[0.16em] text-ink-900 transition hover:text-terracotta-500"
    >
      {t.common.bookNow}
      <Icon name="arrow-up-right" class="h-4 w-4" />
    </a>
  </div>
</article>
