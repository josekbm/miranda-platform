---
import { hotel, navItems } from "../data/site";
import type { Locale } from "../i18n/ui";
import { getTranslations, routeFor } from "../i18n/ui";
import Icon from "./Icon.astro";
import Logo from "./Logo.astro";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getTranslations(locale);
const year = new Date().getFullYear();
---

<footer class="bg-ink-900 text-sand-100">
  <div class="container-miranda py-16 lg:py-20">
    <div class="grid gap-12 lg:grid-cols-[1.4fr_0.8fr_0.8fr_1.2fr]">
      <div>
        <Logo href={routeFor(locale, "home")} variant="light" />
        <p class="mt-6 max-w-sm text-sm leading-7 text-white/55">{t.footer.tagline}</p>
        <div class="mt-6 flex items-center gap-3">
          <a
            href="https://instagram.com"
            target="_blank"
            rel="noreferrer"
            aria-label="Instagram"
            class="grid h-10 w-10 place-items-center rounded-full border border-white/15 text-white/70 transition hover:border-brass-400 hover:text-brass-400"
          >
            <Icon name="instagram" class="h-4 w-4" />
          </a>
          <a
            href="https://facebook.com"
            target="_blank"
            rel="noreferrer"
            aria-label="Facebook"
            class="grid h-10 w-10 place-items-center rounded-full border border-white/15 text-white/70 transition hover:border-brass-400 hover:text-brass-400"
          >
            <Icon name="facebook" class="h-4 w-4" />
          </a>
        </div>
      </div>

      <div>
        <h3 class="text-[10px] font-semibold uppercase tracking-[0.28em] text-brass-400">
          {t.footer.explore}
        </h3>
        <ul class="mt-5 space-y-3 text-sm text-white/60">
          {navItems.map((key) => (
            <li>
              <a href={routeFor(locale, key)} class="transition hover:text-white">
                {t.nav[key]}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <div>
        <h3 class="text-[10px] font-semibold uppercase tracking-[0.28em] text-brass-400">
          {t.footer.services}
        </h3>
        <ul class="mt-5 space-y-3 text-sm text-white/60">
          <li>{t.footer.service1}</li>
          <li>{t.footer.service2}</li>
          <li>{t.footer.service3}</li>
          <li>{t.footer.service4}</li>
          <li>{t.footer.service5}</li>
        </ul>
      </div>

      <div>
        <h3 class="text-[10px] font-semibold uppercase tracking-[0.28em] text-brass-400">
          {t.footer.contact}
        </h3>
        <div class="mt-5 space-y-4 text-sm text-white/60">
          <a
            href={`tel:${hotel.phone.replace(/\s/g, "")}`}
            class="flex items-start gap-3 hover:text-white"
          >
            <Icon name="phone" class="mt-0.5 h-4 w-4 text-brass-400" />
            {hotel.phone}
          </a>
          <a href={`mailto:${hotel.email}`} class="flex items-start gap-3 hover:text-white">
            <Icon name="mail" class="mt-0.5 h-4 w-4 text-brass-400" />
            {hotel.email}
          </a>
          <p class="flex items-start gap-3">
            <Icon name="map-pin" class="mt-0.5 h-4 w-4 shrink-0 text-brass-400" />
            <span>{hotel.address}, {hotel.city}</span>
          </p>
        </div>

        <form action={routeFor(locale, "contact")} method="get" class="mt-6">
          <label
            for="newsletter-email"
            class="text-[10px] font-semibold uppercase tracking-[0.22em] text-white/45"
          >
            {t.common.newsletter}
          </label>
          <div class="mt-2 flex overflow-hidden rounded-full border border-white/15 bg-white/5">
            <input
              id="newsletter-email"
              name="email"
              type="email"
              required
              placeholder={t.common.newsletterPlaceholder}
              class="min-w-0 flex-1 bg-transparent px-4 py-3 text-sm text-white placeholder:text-white/35 focus:outline-none"
            >
            <button
              type="submit"
              class="grid w-12 place-items-center bg-brass-400 text-ink-900 transition hover:bg-white"
              aria-label={t.common.subscribe}
            >
              <Icon name="arrow-right" class="h-4 w-4" />
            </button>
          </div>
          <p class="mt-2 text-[11px] leading-5 text-white/35">{t.footer.newsletterNote}</p>
        </form>
      </div>
    </div>

    <div
      class="mt-14 flex flex-col gap-4 border-t border-white/10 pt-6 text-xs text-white/35 sm:flex-row sm:items-center sm:justify-between"
    >
      <p>© {year} {hotel.name}. {t.common.rights}</p>
      <div class="flex gap-5">
        <span>{t.footer.legal}</span>
        <span>{t.footer.privacy}</span>
        <span>{t.footer.cookies}</span>
      </div>
    </div>
  </div>
</footer>
