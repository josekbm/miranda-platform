---
import {
  formatPrice,
  nightlyRateCents,
  type RoomData,
  roomAmenities,
  roomDescription,
  roomName,
  roomTypeLabel,
} from "../data/rooms";
import { imageUrl } from "../data/site";
import type { Locale } from "../i18n/ui";
import { getTranslations, roomPath } from "../i18n/ui";
import Icon from "./Icon.astro";

interface Props {
  room: RoomData;
  locale: Locale;
}

const { room, locale } = Astro.props;
const t = getTranslations(locale);
const name = roomName(room, locale);
const description = roomDescription(room, locale);
const type = roomTypeLabel(room.type, locale);
const price = formatPrice(nightlyRateCents(room), locale);
const originalPrice = formatPrice(room.priceCents, locale);
const amenities = roomAmenities(room);
const href = roomPath(locale, room.slug);
const image = room.images[0];
const src = imageUrl(image.url, 900);
const srcset = `${imageUrl(image.url, 600)} 600w, ${imageUrl(image.url, 900)} 900w, ${imageUrl(image.url, 1200)} 1200w`;
---

<article
  class="group flex h-full flex-col overflow-hidden rounded-[1.75rem] border border-ink-900/10 bg-white transition duration-500 hover:-translate-y-1 hover:shadow-[0_24px_80px_rgba(29,27,24,0.12)]"
>
  <a href={href} class="relative block aspect-[4/3] overflow-hidden bg-sand-200">
    <img
      src={src}
      srcset={srcset}
      sizes="(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw"
      alt={locale === "es" ? image.altEs : image.altEn}
      width="900"
      height="675"
      loading="lazy"
      decoding="async"
      class="h-full w-full object-cover transition duration-700 group-hover:scale-105"
    >
    <div class="absolute inset-x-0 top-0 flex items-start justify-between p-4">
      <span
        class="rounded-full bg-ink-900/80 px-3 py-1.5 text-[10px] font-semibold uppercase tracking-[0.18em] text-white backdrop-blur"
      >
        {type}
      </span>
      {room.discountPct > 0 && (
        <span class="rounded-full bg-brass-400 px-3 py-1.5 text-[10px] font-semibold uppercase tracking-[0.14em] text-ink-900">
          -{room.discountPct}%
        </span>
      )}
    </div>
  </a>

  <div class="flex flex-1 flex-col p-6">
    <div class="flex items-start justify-between gap-4">
      <div>
        <p class="text-[10px] font-semibold uppercase tracking-[0.22em] text-ink-500">
          {t.rooms.capacity}: {room.capacity} · {room.sizeSqm} m²
        </p>
        <h3 class="mt-2 font-display text-2xl leading-tight text-ink-900">
          <a href={href} class="transition hover:text-terracotta-500">{name}</a>
        </h3>
      </div>
      <span
        class="rounded-full border border-ink-900/10 px-3 py-1 text-xs font-semibold text-ink-500"
      >
        {room.roomNumber}
      </span>
    </div>

    <p class="mt-3 line-clamp-3 text-sm leading-6 text-ink-500">{description}</p>

    <div class="mt-5 flex flex-wrap items-center gap-3 text-ink-500">
      {amenities.slice(0, 4).map((amenity) => (
        <span class="flex items-center gap-1.5 text-[11px]">
          <Icon name={amenity.icon} class="h-4 w-4 text-sea-700" />
          {locale === "es" ? amenity.labelEs : amenity.labelEn}
        </span>
      ))}
      {amenities.length > 4 && (
        <span class="text-[11px] text-ink-500">+{amenities.length - 4}</span>
      )}
    </div>

    <div class="mt-auto flex items-end justify-between border-t border-ink-900/10 pt-5">
      <div>
        {room.discountPct > 0 && <p class="text-xs text-ink-500 line-through">{originalPrice}</p>}
        <p class="text-xl font-semibold text-ink-900">
          {price}
          <span class="text-xs font-normal text-ink-500">{t.common.perNight}</span>
        </p>
      </div>
      <a
        href={href}
        class="inline-flex items-center gap-1.5 text-xs font-semibold uppercase tracking-[0.16em] text-ink-900 transition hover:text-terracotta-500"
      >
        {t.common.viewRoom}
        <Icon name="arrow-up-right" class="h-4 w-4" />
      </a>
    </div>
  </div>
</article>
