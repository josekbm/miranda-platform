---
interface Props {
  href: string;
  variant?: "primary" | "secondary" | "gold" | "ghost";
  class?: string;
}

const { href, variant = "primary", class: className = "" } = Astro.props;

const variants = {
  primary: "btn-primary",
  secondary: "btn-secondary",
  gold: "btn-gold",
  ghost: "btn-ghost",
};
---

<!-- biome-ignore lint/a11y/useAnchorContent: content is provided through the Astro slot -->
<a href={href} class:list={[variants[variant], className]}>
  <slot />
</a>
